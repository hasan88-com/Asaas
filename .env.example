# =============================================================================
# ASAAS (اثاثہ) — Environment Variables
# =============================================================================
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# --- Supabase (Auth + Database) ---
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here
# Get this from: Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# --- Database ---
# Pooler URL (PgBouncer, port 6543) — used by the FastAPI application
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-password@your-pooler-host:6543/postgres
# Direct connection (port 5432) — used by Alembic migrations only
DATABASE_URL_SYNC=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM Providers (REQUIRED) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- LLM Providers (OPTIONAL) ---
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# --- Data Sources (REQUIRED) ---
COINGECKO_API_KEY=
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- App Settings ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
GUEST_FREE_RUNS=3
ENVIRONMENT=development
